# Copy the real values from:  python -m bank.keys > .env
# Never commit .env. These placeholders are deliberately invalid, so the
# service refuses to start until real keys are generated.
BANK_ENV=production
BANK_CARD_OTP_SECRET=
BANK_CARD_KEY=
BANK_DEVICE_KEY=
BANK_TOKEN_KEY=
BANK_CLIENTS=
BANK_HOST=127.0.0.1
BANK_PORT=8080

MCP_BANK_URL=http://127.0.0.1:8080
MCP_CLIENT_ID=fraud-agent
MCP_CLIENT_SECRET=
